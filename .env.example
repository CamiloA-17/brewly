# Copy to .env and adjust. Used by docker compose, the Makefile and the server.

# PostgreSQL (docker compose "db" service)
POSTGRES_USER=brewly
POSTGRES_PASSWORD=brewly
POSTGRES_DB=brewly_dev
DATABASE_URL=postgres://brewly:brewly@localhost:5432/brewly_dev?sslmode=disable

# dbmate
DBMATE_MIGRATIONS_DIR=database/migrations
DBMATE_NO_DUMP_SCHEMA=true

# Server. Required: generate your own secret with `openssl rand -base64 48`.
# The server refuses to start while it is empty or shorter than 32 characters.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
LOG_LEVEL=debug

# Password of the demo accounts created by `make db-seed` (at least 8 characters).
DEMO_PASSWORD=

# Google: Web application OAuth client ID used as the backend token audience.
# Leave empty to disable Google authentication on the API.
GOOGLE_SERVER_CLIENT_ID=

# Apple: registered iOS bundle ID, Developer Team ID and Sign in with Apple key ID.
# Leave APPLE_CLIENT_ID empty to disable Apple authentication on the API.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Base64 of the .p8 key file; never commit the file or this value.
APPLE_PRIVATE_KEY_BASE64=
# Generate with `openssl rand -base64 32`. Keep stable across JWT_SECRET rotations.
APPLE_TOKEN_ENCRYPTION_KEY=
